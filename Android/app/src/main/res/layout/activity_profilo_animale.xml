<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <FrameLayout
        android:id="@+id/header_home"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/Pippo"
            android:layout_width="800dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="-35dp"
            android:src="@drawable/cricle_1" />

    </FrameLayout>

    <!--fine immagine logo-->


    <TextView
        android:id="@+id/nomeProfiloAnimale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_home"
        android:layout_marginTop="0dp"
        android:padding="20dp"
        android:text="NOME Animale"
        android:textSize="26sp" />

    <!--prima linea -->

    <LinearLayout
        android:padding="20dp"
        android:id="@+id/primaLinea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/nomeProfiloAnimale"
        android:orientation="horizontal">


            <LinearLayout
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peso"
                    android:textAlignment="textStart" />

                <TextView
                    android:id="@+id/pesoProfiloAnimale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20dp"/>


            </LinearLayout>


            <LinearLayout
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sesso"
                    android:textAlignment="textStart" />

                <TextView
                    android:id="@+id/sessoProfiloAnimale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20dp"/>

            </LinearLayout>

    </LinearLayout>
    <!--seconda linea-->
    <LinearLayout
        android:padding="20dp"
        android:id="@+id/secondaLinea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/primaLinea"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Altezza"
                android:textAlignment="textStart" />

            <TextView
                android:id="@+id/altezzaProfiloAnimale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp"/>


        </LinearLayout>




        <LinearLayout
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data di nascita"
                android:textAlignment="textStart" />

            <TextView
                android:id="@+id/dataProfiloAnimale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp"/>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/terzaLinea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/secondaLinea"
        android:orientation="horizontal"
        android:padding="20dp">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note"
                android:textAlignment="textStart" />

            <TextView
                android:id="@+id/noteProfiloAnimale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20dp" />


        </LinearLayout>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/terzaLinea"
        >

        <Button
            android:id="@+id/modificaBTN"
            android:layout_width="165dp"
            android:layout_height="wrap_content"
            android:text="modifica profilo"
            android:backgroundTint="@color/Blu_base"/>

        <Button
            android:id="@+id/cartellaClinicaBTN"
            android:layout_width="242dp"
            android:layout_height="93dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:text="cartella clinica"
            android:backgroundTint="@color/Blu_base"/>

        <Button
            android:id="@+id/cancellaBTN"
            android:layout_width="165dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:backgroundTint="@color/Blu_base"
            android:text="cancella profilo" />


    </RelativeLayout>






    </RelativeLayout>










