<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/header_home"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/Pippo"
            android:layout_width="800dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="-35dp"
            android:src="@drawable/cricle_1" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/llInfoServizio"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_home"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgService"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/img_service" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvNomeServizio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="5dp"
                android:text="Nome Servizio"
                android:textSize="18dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTipoServizio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvNomeServizio"
                android:text="Tipo Servizio" />

            <RatingBar
                android:id="@+id/rbRatingServizio"
                style="?android:attr/ratingBarStyleIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="15dp"
                android:rating="2" />

        </RelativeLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/llIndirizzoServizio"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/llInfoServizio"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIndirizzoServizio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Via Esempio molto Bella, 123"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCityServizio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="5dp"
            android:text="Milano" />

        <TextView
            android:id="@+id/tvCapServizio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12345" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvOrarioServizio"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/llIndirizzoServizio"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:gravity="center_horizontal"
        android:text="09.00 - 12.30, 13.30 - 18.00 chiuso sabato mattina e domenica"/>

