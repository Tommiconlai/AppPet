<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/header_home"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/Pippo"
            android:layout_width="800dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="-35dp"
            android:src="@drawable/cricle_1" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/llInfoServizio"
        android:layout_below="@id/header_home"
        android:layout_width="350dp"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgService"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/img_service" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvNomeServizio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="5dp"
                android:text="Nome Servizio"
                android:textSize="18dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTipoServizio"
                android:layout_below="@id/tvNomeServizio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo Servizio"/>

            <RatingBar
                android:id="@+id/rbRatingServizio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="15dp"
                style="?android:attr/ratingBarStyleIndicator"
                android:rating="2"/>

        </RelativeLayout>





        </LinearLayout>



    <LinearLayout
        android:id="@+id/llIndirizzoServizio"
        android:layout_below="@id/llInfoServizio"
        android:layout_width="350dp"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tvIndirizzoServizio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Via Esempio molto Bella, 123"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCityServizio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Milano"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="5dp"/>

        <TextView
            android:id="@+id/tvCapServizio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12345"/>

    </LinearLayout>

    <LinearLayout
        android:layout_below="@id/llIndirizzoServizio"
        android:layout_centerHorizontal="true"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_rectangle"
        android:backgroundTint="@color/grey">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lun"/>

            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mar"/>

            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mer"/>

            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gio"/>

            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ven"/>

            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sab"/>

            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dom"/>


        </LinearLayout>



    </LinearLayout>

    <TextView
        android:id="@+id/OrarioProfAtt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Orario:"
        android:textSize="18dp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/Recensione"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Aggiungi una recensione qui"
        android:textSize="18dp"
        android:textStyle="bold" />


</RelativeLayout>

